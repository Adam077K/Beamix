# Beamix — apps/web environment variables
# Copy to .env.local for local development. Never commit real secrets.

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Inngest ────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── OpenRouter ─────────────────────────────────────────────────────────────
# Scan-dedicated key (preferred for cost isolation). Falls back to OPENROUTER_API_KEY.
OPENROUTER_SCAN_KEY=
# Shared key used by the agent system (and scan pipeline if OPENROUTER_SCAN_KEY is absent).
OPENROUTER_API_KEY=

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Paddle ─────────────────────────────────────────────────────────────────
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_DISCOVER_PRICE_ID_MONTHLY=
PADDLE_DISCOVER_PRICE_ID_ANNUAL=
PADDLE_BUILD_PRICE_ID_MONTHLY=
PADDLE_BUILD_PRICE_ID_ANNUAL=
PADDLE_SCALE_PRICE_ID_MONTHLY=
PADDLE_SCALE_PRICE_ID_ANNUAL=

# ── Resend ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Security ───────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=
# HMAC signing key for adamkey bypass tokens
ADAMKEY_SECRET=
# Comma-separated CIDR blocks to skip rate limiting (optional)
RATE_LIMIT_ALLOWLIST=

# ── Free Scan — budget guards ──────────────────────────────────────────────
# Max accepted free scans in a 24-hour window before the kill switch trips.
# Default: 500. Set lower in staging, higher if traffic grows.
SCAN_FREE_DAILY_BUDGET=500
# Max accepted free scans in a 1-hour window. Hourly soft cap (no kill switch flip).
# Default: 60.
SCAN_FREE_HOURLY_BUDGET=60

# ── Debug flags ────────────────────────────────────────────────────────────
# Set to "1" to log full OpenRouter error response bodies in development.
# Leave unset in production to avoid leaking partial key material in logs.
DEBUG_OPENROUTER=
